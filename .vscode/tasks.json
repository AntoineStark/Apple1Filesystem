{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build emulator",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--parallel",
				"4"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},
		{
			"label": "Clean rebuild (CLI preset)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"debug",
				"--clean-first"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}